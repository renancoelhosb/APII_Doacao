<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="150.0" prefWidth="300.0" style="-fx-background-position: center;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.NewProductWindowController">
   <children>
      <AnchorPane prefHeight="150.0" prefWidth="250.0">
         <children>
            <VBox alignment="CENTER" prefHeight="150.0" prefWidth="300.0" spacing="5.0" style="-fx-background-color: white;">
               <children>
                  <Label text="Nome do produto:">
                     <padding>
                        <Insets left="5.0" right="5.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="textField_product_name" />
                  <HBox alignment="CENTER" prefHeight="40.0" prefWidth="260.0" spacing="20.0">
                     <children>
                        <Button fx:id="btn_registerProduct" mnemonicParsing="false" onMouseClicked="#handleRegisterProduct" style="-fx-background-color: black;" text="Cadastrar" textFill="WHITE" />
                        <Button fx:id="btn_cancel" mnemonicParsing="false" onMouseClicked="#handleGoBackToStockPane" style="-fx-background-color: black;" text="Cancelar" textFill="WHITE" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
